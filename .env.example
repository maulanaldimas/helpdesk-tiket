# Copy this file to .env and adjust the values.
# NEVER commit the actual .env file to the repository.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Database (default: SQLite for local dev; PostgreSQL for Docker)
# For Docker, DB_PASSWORD is required — set it below.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=helpdesk
# DB_USER=helpdesk
DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Locale & timezone
LANGUAGE_CODE=id
TIME_ZONE=Asia/Jakarta

# Email — development: console output. Production: fill in SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=helpdesk@sokkafiber.local

# Public URL for email links
SITE_URL=http://127.0.0.1:8000

# Self-registration (True/False)
REGISTRATION_OPEN=True

# Logging
LOG_LEVEL=INFO

# Session idle timeout (seconds, default 30 min)
IDLE_TIMEOUT=1800
