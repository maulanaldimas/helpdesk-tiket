# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit .env asli ke repository.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Database (default: SQLite). Contoh untuk PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=helpdesk
# DB_USER=helpdesk
# DB_PASSWORD=secret
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Lokal & zona waktu
LANGUAGE_CODE=id
TIME_ZONE=Asia/Jakarta

# Email — development: cetak ke console. Produksi: isi SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=helpdesk@sokkafiber.local

# URL publik untuk link di email
SITE_URL=http://127.0.0.1:8000

# Logging
LOG_LEVEL=INFO
